{
  "private": false,
  "displayName": "Homebridge Atomberg Fan v2",
  "name": "homebridge-atomberg-fan-v2",
  "version": "2.0.0",
  "description": "Homebridge platform plugin for Atomberg Smart Fans. Adds Homebridge v2.0 compatibility, the 6th (Boost) speed, LED on/off + brightness + colour-temperature control, local UDP state sync, debounce + throttle, and offline detection.",
  "license": "Apache-2.0",
  "author": "Dhananjay Sathe <dhananjaysathe@gmail.com>",
  "contributors": [
    "Sangwan5688 (original plugin author)",
    "Gurmeher Chawla (LED control)",
    "Kevin Deason (6-speed mapping concept)",
    "Vishal CJ (UDP hardening + debounce/throttle + offline detection)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhananjaysathe/homebridge-atomberg-fan-v2.git"
  },
  "bugs": {
    "url": "https://github.com/dhananjaysathe/homebridge-atomberg-fan-v2/issues"
  },
  "homepage": "https://github.com/dhananjaysathe/homebridge-atomberg-fan-v2#readme",
  "engines": {
    "node": "^18.20.4 || ^20.15.1 || ^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf ./dist",
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "npm run clean && tsc",
    "build-watch": "npm run clean && tsc -w",
    "prepublishOnly": "npm run lint && npm run build",
    "postpublish": "npm run clean"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "atomberg",
    "atomberg-fan",
    "smart-fan",
    "renesa",
    "aris",
    "efficio",
    "erica",
    "gorilla",
    "studio",
    "boost",
    "fan",
    "led"
  ],
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.7",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
